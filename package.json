    "bin/",
    "skills/",
    ".claude-plugin/",
    "README.md",
    "README.pt.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "verificar": "python tools/verifica.py && node bin/instalar.js --verificar"
  },
  "keywords": [
    "claude-code",
    "claude-skill",
    "agent-skills",
